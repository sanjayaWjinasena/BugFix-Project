  <record id="rule_762_project_task_project_users_follow_required_for_follower_only" model="ir.rule">
    <field name="name">Project/Task: project users: follow required for follower-only projects</field>
    <field name="model_id" ref="BugFix-Project.model_project_task"/>
    <field name="domain_force">[
            '|',
                '&amp;',
                    ('project_id', '!=', False),
