<odoo>
  <record id="aw_f4_project_project_project_project" model="ir.actions.act_window">
    <field name="name">project.project</field>
    <field name="res_model">project.project</field>
    <field name="view_mode">kanban,tree,form,gantt</field>
  </record>
  <record id="aw_f4_project_task_project_task" model="ir.actions.act_window">
