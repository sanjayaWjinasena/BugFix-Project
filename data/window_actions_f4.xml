  <record id="aw_f4_project_update_project_update" model="ir.actions.act_window">
    <field name="name">project.update</field>
    <field name="res_model">project.update</field>
    <field name="view_mode">kanban,tree,form</field>
  </record>
  <record id="aw_f4_project_project_projects_project_project" model="ir.actions.act_window">
    <field name="name">Projects (project.project)</field>
    <field name="res_model">project.project</field>
    <field name="view_mode">kanban,tree,form,gantt</field>
