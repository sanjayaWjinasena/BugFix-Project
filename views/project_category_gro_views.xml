<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_project_category_group" model="ir.actions.act_window">
    <field name="name">Project Category Group</field>
    <field name="res_model">project_category_gro</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
  <record id="view_project_category_gro_form" model="ir.ui.view">
    <field name="name">Default form view for project_category_gro</field>
    <field name="model">project_category_gro</field>
    <field name="key">studio_customization.default_form_view_fo_4c47b759-0437-4a50-8bde-31e224e98d73</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Project Category Group">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_f4b54e">
            <group name="studio_group_f4b54e_left"/>
            <group name="studio_group_f4b54e_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="view_project_category_gro_list" model="ir.ui.view">
    <field name="name">Default list view for project_category_gro</field>
    <field name="model">project_category_gro</field>
    <field name="key">studio_customization.default_list_view_fo_bec9b336-4bd6-4f26-9907-592cba56fed5</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_project_category_gro_search" model="ir.ui.view">
    <field name="name">Default search view for project_category_gro</field>
    <field name="model">project_category_gro</field>
    <field name="key">studio_customization.default_search_view__848b9042-a23c-4ede-bd0a-959bc46f916e</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_project_category_gro" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
  <record id="view_default_list_view_for_project_category_gro_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for project_category_gro customization</field>
    <field name="model">project_category_gro</field>
    <field name="key">studio_customization.odoo_studio_default__85283cff-70e4-4b23-b216-f01c6954b1cd</field>
    <field name="type">tree</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Project.view_project_category_gro_list"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//tree[1]" position="attributes">
          <attribute name="editable">bottom</attribute>
        </xpath>
        
        
        
      </data>
    </field>
  </record>
</odoo>
