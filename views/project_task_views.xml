<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="aw_f4_project_task_project_task" model="ir.actions.act_window">
    <field name="name">project.task</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">kanban,tree,form,calendar,gantt,map,pivot,graph,activity,cohort</field>
  </record>
  <record id="action_2802_project_task" model="ir.actions.act_window">
    <field name="name">project.task</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">kanban,tree,form,calendar,gantt,map,pivot,graph,activity,cohort</field>
  </record>
  <record id="act_window_251_tasks" model="ir.actions.act_window">
    <field name="name">Tasks</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">tree,gantt,kanban,form,calendar,pivot,graph,activity</field>
    <field name="domain">[('project_id', '=', active_id)]</field>
    <field name="context">{
                'pivot_row_groupby': ['user_ids'],
                'default_project_id': active_id,
                'show_project_update': True,
            }</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    No tasks found. Let's create one!
                </p><p>
                    To get things done, use activities and status on tasks.<br/>
                    Chat in real-time or by email to collaborate efficiently.
                </p>
            </field>
  </record>
  <record id="act_window_266_assigned_tasks" model="ir.actions.act_window">
    <field name="name">Assigned Tasks</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">tree,form,calendar,graph,pivot</field>
    <field name="domain">[('project_id', '!=', False)]</field>
    <field name="context">{'search_default_user_ids': [active_id], 'default_user_ids': [(6, 0, [active_id])]}</field>
  </record>
  <record id="act_window_1916_project_sharing" model="ir.actions.act_window">
    <field name="name">Project Sharing</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('project_id', '=', active_id), ('display_in_project', '=', True)]</field>
    <field name="context">{
            'default_project_id': active_id,
            'delete': 0,
            'active_id_chatter': active_id,
        }</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                No tasks found. Let's create one!
            </p>
            <p>
                Keep track of the progress of your tasks from creation to completion.<br/>
                Collaborate efficiently by chatting in real-time or via email.
            </p>
        </field>
  </record>
  <record id="ported_view_project_task_form_3019" model="ir.ui.view">
    <field name="name">Odoo Studio: project.task.form customization</field>
    <field name="model">project.task</field>
    <field name="key">Fix-repair.view_project_task_form_3019</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="arch" type="xml">
      <data>
        <!-- fix_repair:sanitized-v190 -->
        
        
        
        
        
        <xpath expr="//notebook" position="inside">
          <page string="Repair Image" name="studio_page_8ci_1ik1qk8tm">
            <group name="studio_group_8ci">
              <group name="studio_group_8ci_left">
                <field name="x_studio_repair_image_01" widget="tablet_image"/>
              </group>
              <group name="studio_group_8ci_right">
                <field name="x_studio_repair_image_02" widget="tablet_image"/>
              </group>
            </group>
          </page>
          <page string="Warranty Card" name="studio_page_8db_1ik1r0ore">
            <group name="studio_group_8db">
              <group name="studio_group_8db_left">
                <field name="x_studio_warranty_card" widget="image"/>
              </group>
              <group name="studio_group_8db_right">
                <field name="x_studio_related_information" widget="image"/>
              </group>
            </group>
          </page>
          
        </xpath>
      </data>
    </field>
  </record>
