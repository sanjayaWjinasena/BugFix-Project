<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_bd8d3ada_46a1_4fd3_9469_e13371fb5db3" model="ir.ui.view">
    <field name="name">Default form view for x_departments</field>
    <field name="model">x_departments</field>
    <field name="key">studio_customization.default_form_view_fo_bd8d3ada-46a1-4fd3-9469-e13371fb5db3</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Departments">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_63a97d">
            <group name="studio_group_63a97d_left">
              <field name="x_studio_user_id" widget="many2one_avatar_user"/>
            </group>
            <group name="studio_group_63a97d_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_a3146a55_ec15_4748_b6e8_4e6005b08549" model="ir.ui.view">
    <field name="name">Default list view for x_departments</field>
    <field name="model">x_departments</field>
    <field name="key">studio_customization.default_list_view_fo_a3146a55-ec15-4748-b6e8-4e6005b08549</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
        <field name="x_studio_user_id" widget="many2one_avatar_user"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__8ffb2001_1b7c_4a47_a326_117b4137bb47" model="ir.ui.view">
    <field name="name">Default search view for x_departments</field>
    <field name="model">x_departments</field>
    <field name="key">studio_customization.default_search_view__8ffb2001-1b7c-4a47-a326-117b4137bb47</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <field name="x_studio_user_id"/>
        <filter string="My Departments" name="my_x_departments" domain="[['x_studio_user_id', '=', uid]]"/>
        <separator/>
        <filter string="Archived" name="archived_x_departments" domain="[['x_active', '=', False]]"/>
        <separator/>
        <filter name="groupby_x_user" string="Responsible" context="{'group_by': 'x_studio_user_id'}" domain="[]"/>
      </search>
    </field>
  </record>
</odoo>
