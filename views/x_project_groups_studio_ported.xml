    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_project_groups" domain="[['x_active', '=', False]]"/>
