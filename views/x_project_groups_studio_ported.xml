    <field name="key">studio_customization.default_list_view_fo_289ae9dd-5621-40c9-a6c8-caffa4299140</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__1ba8dab6_4af4_45b5_ac3e_42e6825cdd43" model="ir.ui.view">
