          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_937238">
            <group name="studio_group_937238_left"/>
            <group name="studio_group_937238_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_289ae9dd_5621_40c9_a6c8_caffa4299140" model="ir.ui.view">
