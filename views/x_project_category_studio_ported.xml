<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_812ed9c2_8d16_424f_87f2_f0547b559de4" model="ir.ui.view">
    <field name="name">Default form view for x_project_category</field>
    <field name="model">x_project_category</field>
    <field name="key">studio_customization.default_form_view_fo_812ed9c2-8d16-424f-87f2-f0547b559de4</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Project Category">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_d469de">
            <group name="studio_group_d469de_left"/>
            <group name="studio_group_d469de_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_fe816227_617a_40c5_bd57_43e1393438be" model="ir.ui.view">
    <field name="name">Default list view for x_project_category</field>
    <field name="model">x_project_category</field>
    <field name="key">studio_customization.default_list_view_fo_fe816227-617a-40c5-bd57-43e1393438be</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__0109453b_5222_4c2f_86c8_68a69bf444de" model="ir.ui.view">
    <field name="name">Default search view for x_project_category</field>
    <field name="model">x_project_category</field>
    <field name="key">studio_customization.default_search_view__0109453b-5222-4c2f-86c8-68a69bf444de</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_project_category" domain="[['x_active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
  <record id="ported_odoo_studio_default__1f20671c_d39c_4464_9e3c_0c77ab8f748b" model="ir.ui.view">
