<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_project_groups" model="ir.actions.act_window">
    <field name="name">Project Groups</field>
    <field name="res_model">project_groups</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="view_project_groups_form" model="ir.ui.view">
    <field name="name">Default form view for project_groups</field>
    <field name="model">project_groups</field>
    <field name="key">studio_customization.default_form_view_fo_3f299c76-71ec-4033-87c7-58900e29e002</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Project Groups">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_937238">
            <group name="studio_group_937238_left"/>
            <group name="studio_group_937238_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="view_project_groups_list" model="ir.ui.view">
    <field name="name">Default list view for project_groups</field>
    <field name="model">project_groups</field>
    <field name="key">studio_customization.default_list_view_fo_289ae9dd-5621-40c9-a6c8-caffa4299140</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_project_groups_search" model="ir.ui.view">
    <field name="name">Default search view for project_groups</field>
    <field name="model">project_groups</field>
    <field name="key">studio_customization.default_search_view__1ba8dab6-4af4-45b5-ac3e-42e6825cdd43</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_project_groups" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
  <record id="view_default_list_view_for_project_groups_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for project_groups customization</field>
    <field name="model">project_groups</field>
    <field name="key">studio_customization.odoo_studio_default__c9cffa3c-2353-4dba-bc25-27f33202c35e</field>
    <field name="type">tree</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Project.view_project_groups_list"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//tree[1]" position="attributes">
          <attribute name="editable">bottom</attribute>
        </xpath>
        
        
        
      </data>
    </field>
  </record>
</odoo>
