                <field widget="tablet_image" name="x_studio_image_1" string="Image 1"/>
                <field widget="tablet_image" name="x_studio_image_2" string="Image 2"/>
                <field widget="tablet_image" name="x_studio_image_3" string="Image 3"/>
              </group>
            </group>
          </page>
        </xpath>
      </data>
    </field>
